# Public node REST endpoint the browser talks to directly (it answers CORS with *).
NEXT_PUBLIC_VAULT_REST=https://vaultl1-devnet.fly.dev
# Storage provider. In "proxy" mode the browser only talks to this site's /api/provider route,
# which forwards a fixed allowlist of paths to this URL.
NEXT_PUBLIC_VAULT_PROVIDER=https://vaultl1-provider.fly.dev
# "proxy" (default) or "direct" (needs the provider's ALLOW_ORIGIN set to this site's origin).
NEXT_PUBLIC_VAULT_PROVIDER_MODE=proxy
# Optional, server-side only: override where the proxy forwards to.
# VAULT_PROVIDER_URL=
